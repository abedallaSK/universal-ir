<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required by ConsumerIrManager.transmit(); a normal (install-time) permission. -->
    <uses-permission android:name="android.permission.TRANSMIT_IR" />
    <!-- Code-pack downloads the user asks for, and Wi-Fi remotes on the local network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wi-Fi remotes: check the phone is on Wi-Fi and receive SSDP/mDNS multicast replies. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Not required: the app still opens, explains and lets users browse codes without an emitter. -->
    <uses-feature
        android:name="android.hardware.consumerir"
        android:required="false" />

    <application
        android:name=".UniversalIrApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.UniversalIR.Starting"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen widgets (Jetpack Glance), see widget/. -->
        <receiver
            android:name=".widget.DeviceRemoteWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_remote_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_device_remote_info" />
        </receiver>

        <receiver
            android:name=".widget.FavoritesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_fav_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_favorites_info" />
        </receiver>

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/widget_config_title"
            android:theme="@style/Theme.UniversalIR">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Lets AppCompat persist the per-app language on API < 33. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
