    <string name="set_privacy">פרטיות</string>
    <string name="set_privacy_body">אין חשבון, אין אנליטיקה, אין מיקום, מצלמה, מיקרופון או אנשי קשר. הנתונים נשארים בטלפון. הרשת משמשת רק לשלטי Wi-Fi ברשת הביתית ולחבילות קודים שאתם מורידים.</string>
    <string name="about_body">שלט אינפרא-אדום אוניברסלי לטלפונים עם משדר מובנה. הקודים מסומנים לפי רמת ראיות; תאימות נטענת רק כשיש ראיות.</string>
    <string name="about_protocols">פרוטוקולים נתמכים</string>
    <string name="about_limitations">מגבלות ידועות</string>
    <string name="about_limitations_body">• אין למידת קודים: לטלפון אין מקלט אינפרא-אדום.\n• אי אפשר לקרוא את המצב האמיתי של המזגן; האפליקציה מציגה את המצב האחרון שהתבקש.\n• אף פרוטוקול עוד לא אושר בחומרה על ידי הפרויקט; הרמות עולות רק כשמשתמשים מאשרים קודים.\n• Electra של 104 ביט מסומן Alpha במקור; תדר הנושא שלו משוער.\n• הקלטות Broadlink לא שומרות את התדר; מניחים 38 קילוהרץ.\n• פרטי הפרוטוקולים באבחון מוצגים באנגלית.</string>
    <string name="about_notices">הודעות קוד פתוח</string>
    <string name="about_use_esp">מקודדי Electra 104 ביט, Gree ו-Coolix הועברו מספרייה זו (LGPL-2.1); ראו NOTICE.md.</string>
    <string name="about_use_kelon">טבלאות בתים, סכומי ביקורת ורצפי הפעלה של KELON168.</string>
    <string name="about_use_tadiran">מקודד Tadiran 64 ביט; מראה ששלטי Tadiran \'Sakal\' משתמשים במסגרת Gree.</string>
    <string name="about_use_electra34">מקודד Electra 34 ביט במנצ\'סטר (נחלת הכלל).</string>
    <string name="about_use_central">הקלטות אמיתיות של יחידת Electra/Tadiran מרכזית ששימשו כווקטורי ייחוס.</string>
    <string name="about_use_smartir">קודי מזגנים, טלוויזיות ומאווררים מוקלטים מובנים; הקלטות ייחוס לבדיקות.</string>
    <string name="about_use_reference">ייחוס תזמון לפרוטוקולים של מוצרי צריכה.</string>
    <string name="about_use_flipper">פורמט קובץ שהמייבא תומך בו; אין קבצים מובנים.</string>
    <string name="about_use_irdb">פורמט CSV שהמייבא תומך בו לקבצים שתספקו; המאגר לא מובנה ולא מורד כי הרישיון שלו מחייב יידוע הפרויקט.</string>
    <string name="about_use_android">ספריות מסגרת האפליקציה.</string>
    <string name="about_report">דיווח על תוצאת תאימות</string>
    <string name="about_report_body">השתמשו בתשובות כן/לא באשף הקודים: התוצאות נשמרות עם דגם הטלפון בהיסטוריית האימות ואפשר לייצא אותן מעמוד מאגר הקודים.</string>
